---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  searchPlaceholder?: string;
  activeView: 'subjects' | 'courses';
}

const { 
  title = 'Ämnen i GY25',
  description,
  searchPlaceholder = 'Sök...',
  activeView 
} = Astro.props;
---

<Layout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex flex-col items-center gap-6 mb-8">
      <h1 class="text-3xl font-bold text-gray-900 text-center">{activeView === 'subjects' ? 'Ämnen i GY25' : 'Nivåer i GY25'}</h1>
      <nav class="flex gap-4" aria-label="Vy">
        <a 
          href="/gy25"
          aria-current={activeView === 'subjects' ? 'page' : undefined}
          class={`px-4 py-2 rounded-lg transition-colors ${
            activeView === 'subjects' 
              ? 'bg-blue-600 text-white' 
              : 'text-gray-600 hover:bg-gray-100'
          }`}
        >
          Ämnen
        </a>
        <a 
          href="/gy25/courses"
          aria-current={activeView === 'courses' ? 'page' : undefined}
          class={`px-4 py-2 rounded-lg transition-colors ${
            activeView === 'courses' 
              ? 'bg-blue-600 text-white' 
              : 'text-gray-600 hover:bg-gray-100'
          }`}
        >
          Nivåer
        </a>
      </nav>
      
      <div class="w-full max-w-xl relative">
        <label for="search-input" class="sr-only">{searchPlaceholder}</label>
        <input 
          type="search" 
          id="search-input"
          class="w-full px-4 py-3 text-lg rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          placeholder={searchPlaceholder}
        />
        <svg 
          class="absolute right-4 top-3.5 w-6 h-6 text-gray-400" 
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
      </div>
      <p id="search-status" role="status" class="text-sm text-gray-600 min-h-[1.25rem]"></p>
    </div>

    <div id="search-results" class="space-y-4">
      <slot />
      <div id="no-results" class="hidden text-center py-8 text-gray-500">
        Inga resultat hittades
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initSearch } from '../scripts/search';

  initSearch();
</script>
