---
import { getCollection, type CollectionEntry } from 'astro:content';
import GY25Layout from '../../layouts/GY25Layout.astro';
import { validityBadge, badgeClasses } from '../../utils/validity';

interface Course {
  code: string;
  name: string;
  points?: string;
}

type SubjectWithCourses = CollectionEntry<'gy25-subjects'>;

const subjects = await getCollection('gy25-subjects') as SubjectWithCourses[];

// Flatten all courses into a single array with subject information
const courses = subjects.flatMap(subject => 
  subject.data.courses?.map(course => ({
    ...course,
    subjectName: subject.data.name,
    subjectCode: subject.data.code,
    subjectId: subject.id
  })) || []
);

// Sort subjects by name
subjects.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Sort courses by subject name, subject code and then course name
// (the code keeps same-named subjects such as STAD and STAS in separate groups)
courses.sort((a, b) => {
  const subjectCompare = a.subjectName.localeCompare(b.subjectName) || a.subjectCode.localeCompare(b.subjectCode);
  if (subjectCompare !== 0) return subjectCompare;
  return a.name.localeCompare(b.name);
});

const nameCounts = new Map<string, number>();
subjects.forEach(s => nameCounts.set(s.data.name, (nameCounts.get(s.data.name) ?? 0) + 1));

function getSubjectColor(subject: SubjectWithCourses) {
  const categories = subject.data.categories?.map(c => c.name.toLowerCase()) || [];
  if (categories.includes('yrkesämne')) {
    return 'bg-blue-50';       // Light blue
  } else if (categories.includes('vissa ämne')) {
    return 'bg-orange-50';    // Light peach
  } else {
    return 'bg-emerald-50';   // Soft emerald
  }
}

let subjectIndex = -1;
let currentSubject = '';
---

<GY25Layout 
  title="Nivåer i GY25"
  description={`Alla ${courses.length} nivåer i GY25 grupperade per ämne, med nivåkod och poäng.`}
  activeView="courses"
  searchPlaceholder="Sök på nivå, nivåkod eller ämne..."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="space-y-1 divide-y-2 divide-gray-200">
      {courses.map((course, index) => {
        const isNewSubject = currentSubject !== course.subjectCode;
        if (isNewSubject) {
          subjectIndex++;
          currentSubject = course.subjectCode;
        }
        
        const currentSubjectData = subjects.find(s => s.data.code === course.subjectCode);
        const badge = isNewSubject && currentSubjectData
          ? validityBadge(currentSubjectData.data, { always: (nameCounts.get(course.subjectName) ?? 0) > 1 })
          : null;
        const searchTerms = [
          course.name.toLowerCase(),
          course.code.toLowerCase(),
          course.subjectName.toLowerCase(),
          course.subjectCode.toLowerCase()
        ].join(' ');
        
        return (
          <>
          {isNewSubject && currentSubjectData && (
            <div
              class={`${getSubjectColor(currentSubjectData)} rounded-t-lg px-4 py-3 border-b border-gray-200 shadow-sm mt-8 first:mt-0`}
              data-search-heading={course.subjectCode}
            >
              <h2 class="text-lg font-semibold text-gray-900">
                {course.subjectName} <span class="text-sm font-mono font-normal text-gray-600">{course.subjectCode}</span>
              </h2>
              {badge && (
                <p class={`inline-block mt-1 px-2 py-0.5 rounded text-xs font-medium ${badgeClasses[badge.tone]}`}>{badge.label}</p>
              )}
            </div>
          )}
          <div 
            class="rounded-lg overflow-hidden"
            data-search={searchTerms}
            data-search-group={course.subjectCode}
          >
            <div class="px-4 py-3 bg-white hover:bg-gray-50 transition-colors">
              <div class="flex justify-between items-center">
                <div>
                  <a 
                    href={`/gy25/${course.subjectCode.toLowerCase()}/${course.code.toLowerCase()}`}
                    class="group"
                  >
                    <h3 class="text-base font-medium text-gray-900 group-hover:text-blue-600">
                      {course.name}
                    </h3>
                  </a>
                  <p class="text-sm text-gray-500 mt-1">
                    {course.code}
                  </p>
                </div>
                {course.points && (
                  <div class="text-sm text-gray-500">
                    {course.points} poäng
                  </div>
                )}
              </div>
            </div>
          </div>
          </>
        );
      })}
    </div>
  </div>
</GY25Layout>