---
import { safeHtml } from '../../utils/sanitize-html';
import { getCollection, type CollectionEntry } from 'astro:content';
import GY25Layout from '../../layouts/GY25Layout.astro';
import { validityBadge, badgeClasses } from '../../utils/validity';
import { pluralize } from '../../utils/plural';

const subjects = await getCollection('gy25-subjects');

// Sort subjects by name, then by start date so same-named subjects are in order
subjects.sort((a, b) => a.data.name.localeCompare(b.data.name) || a.data.startDate.localeCompare(b.data.startDate));

// Names used by more than one subject (e.g. STAD and STAS "Städservice")
const nameCounts = new Map<string, number>();
subjects.forEach(s => nameCounts.set(s.data.name, (nameCounts.get(s.data.name) ?? 0) + 1));

// Function to determine card color based on subject type
function getCardColor(subject: CollectionEntry<'gy25-subjects'>) {
  const categories = subject.data.categories?.map((c: { name: string }) => c.name.toLowerCase()) || [];
  if (categories.includes('yrkesämne')) {
    return 'bg-blue-50 hover:bg-blue-100';       // Light blue (switched from emerald)
  } else if (categories.includes('vissa ämne')) {
    return 'bg-orange-50 hover:bg-orange-100';   // Light peach
  } else {
    return 'bg-emerald-50 hover:bg-emerald-100'; // Soft emerald (switched from blue)
  }
}
---

<GY25Layout 
  activeView="subjects"
  searchPlaceholder="Sök på ämne eller ämneskod..."
>
  <details class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-700">
    <summary class="cursor-pointer font-medium text-gray-900">Vad betyder färgerna och kategorierna?</summary>
    <p class="mt-3">
      Kortens färg visar vilken kategori Skolverket har gett ämnet. Kategorierna hänger ihop med
      reglerna för vilka lärare som är behöriga att undervisa i ämnet.
    </p>
    <ul class="mt-3 space-y-2">
      <li class="flex items-start gap-2">
        <span class="mt-0.5 inline-block h-4 w-4 flex-shrink-0 rounded border border-emerald-200 bg-emerald-50" aria-hidden="true"></span>
        <span><strong>Kapitel 4-ämne:</strong> ett av de undervisningsämnen som räknas upp i 4 kap. förordningen (2021:1335) om utbildning till lärare och förskollärare, till exempel engelska, fysik och historia.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-0.5 inline-block h-4 w-4 flex-shrink-0 rounded border border-blue-200 bg-blue-50" aria-hidden="true"></span>
        <span><strong>Yrkesämne:</strong> ett ämne inom yrkesutbildningen, där läraren behöver relevanta yrkeskunskaper.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-0.5 inline-block h-4 w-4 flex-shrink-0 rounded border border-orange-200 bg-orange-50" aria-hidden="true"></span>
        <span><strong>Vissa ämne:</strong> ett ämne där Skolverket bestämmer vilken kompetens som är relevant för att undervisa (SKOLFS 2024:600), till exempel akrobatik och artificiell intelligens.</span>
      </li>
    </ul>
    <p class="mt-3 text-xs text-gray-500">Kategorin visas på kortet när du fäller ut det.</p>
  </details>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {subjects.map((subject) => {
      // Prepare search terms while keeping the original layout
      const categories = subject.data.categories?.map(c => c.name).join(' ') || '';
      const courseNames = subject.data.courses?.map(c => c.name).join(' ') || '';
      const searchTerms = [
        subject.data.name,
        subject.data.code,
        categories,
        courseNames
      ].join(' ').toLowerCase();
      const badge = validityBadge(subject.data, { always: (nameCounts.get(subject.data.name) ?? 0) > 1 });

      return (
        <div 
          class={`min-w-0 rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow h-full flex flex-col subject-card ${getCardColor(subject)}`}
          data-search={searchTerms}
        >
          <div class="flex justify-between items-start gap-2 mb-4">
            <div class="flex-grow min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                <a 
                  href={`/gy25/${subject.data.code.toLowerCase()}`}
                  class="group min-w-0"
                >
                  <h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 break-words hyphens-auto">
                    {subject.data.name}
                  </h2>
                </a>
                <span class="text-sm font-mono text-gray-600">{subject.data.code}</span>
              </div>
              {subject.data.courses && (
                <p class="text-sm text-gray-600">
                  {pluralize(subject.data.courses.length, 'nivå')}
                </p>
              )}
              {badge && (
                <p class={`inline-block mt-2 px-2 py-0.5 rounded text-xs font-medium ${badgeClasses[badge.tone]}`}>
                  {badge.label}
                </p>
              )}
            </div>
            <div class="flex flex-shrink-0 gap-2">
              <button 
                type="button"
                class="expand-btn p-2 hover:bg-white/50 rounded-lg transition-colors"
                aria-expanded="false"
                aria-controls={`subject-details-${subject.data.code.toLowerCase()}`}
                aria-label={`Visa nivåer för ${subject.data.name}`}
              >
                <svg aria-hidden="true" class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <a 
                href={`/gy25/${subject.data.code.toLowerCase()}`}
                class="p-2 hover:bg-white/50 rounded-lg transition-colors"
                aria-label={`Gå till ämnet ${subject.data.name}`}
              >
                             <svg aria-hidden="true" class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              </a>
            </div>
          </div>

          <div id={`subject-details-${subject.data.code.toLowerCase()}`} class="expandable-content hidden">
            {subject.data.description && (
              <div class="prose prose-sm max-w-none mb-4" set:html={safeHtml(subject.data.description)} />
            )}
            {subject.data.courses && subject.data.courses.length > 0 && (
              <div class="space-y-1 mb-4">
                <h3 class="text-sm font-medium text-gray-900 mb-2">Nivåer</h3>
                <div class="flex flex-col gap-1">
                  {subject.data.courses.map((course) => (
                    <a 
                      href={`/gy25/${subject.data.code.toLowerCase()}/${course.code.toLowerCase()}`}
                      class="text-sm text-gray-600 hover:text-blue-600 flex items-center justify-between group"
                    >
                      <span>{course.name}</span>
                      <span class="font-mono ml-2 text-gray-600 group-hover:text-blue-600">{course.code}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {subject.data.categories && (
              <div class="flex flex-wrap gap-2">
                {subject.data.categories.map((category) => (
                  <span class="px-3 py-1 bg-white/75 rounded-full text-sm font-medium">
                    {category.name}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>
</GY25Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Expand/collapse functionality
    const expandButtons = document.querySelectorAll('.expand-btn');
    
    expandButtons.forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.subject-card');
        const content = card?.querySelector('.expandable-content');
        const icon = button.querySelector('svg');
        
        if (content && icon) {
          content.classList.toggle('hidden');
          button.setAttribute('aria-expanded', String(!content.classList.contains('hidden')));
          icon.style.transform = content.classList.contains('hidden') ? '' : 'rotate(180deg)';
        }
      });
    });
  });
</script>