---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SubjectView from '../../components/gy11subject.astro';
import GY11LegacyBanner from '../../components/GY11LegacyBanner.astro';
import SourceNote from '../../components/SourceNote.astro';

export async function getStaticPaths() {
  const subjects = await getCollection('gy11-subjects');
  return subjects.map((subject) => ({
    params: { subjectCode: subject.data.code.toLowerCase() },
    props: { subject },
  }));
}

const { subject } = Astro.props;
// Utskriftsraden (VIK-169) identifierar sidan; källa och datum skrivs ut i källrutan (VIK-164).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={`${subject.data.name} - GY11`}>
  <div class="max-w-4xl mx-auto px-4 mt-8 mb-8">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <a href="/gy11" class="text-blue-600 hover:text-blue-800 flex items-center gap-1 text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Tillbaka till GY11-ämnen
      </a>
      <a href="/compare" class="text-sm font-medium text-blue-700 hover:text-blue-800">Jämför med GY25</a>
    </div>

    <p class="hidden print:block text-xs mb-4">
      Ämne: {subject.data.name} ({subject.data.code}), GY11 · {pageUrl}
    </p>

    <div class="mb-6">
      <GY11LegacyBanner compact />
    </div>

    <SubjectView subject={subject} />

    <SourceNote
      version="gy11"
      subjectName={subject.data.name}
      skolfsGrund={subject.data.skolfsGrund}
      skolfsAndring={subject.data.skolfsAndring}
      modifiedDate={subject.data.modifiedDate}
    />

    <section class="mt-10 border-t border-gray-200 pt-4 text-sm text-gray-600">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p>Ändringar i Skolverkets data listas i ändringsloggen.</p>
        </div>
        <a href="/andringar/innehall" class="font-medium text-blue-700 hover:text-blue-800">Se ändringar</a>
      </div>
    </section>
  </div>
</Layout>
