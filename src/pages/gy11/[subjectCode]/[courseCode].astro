---
import { getCollection, type CollectionEntry } from 'astro:content';
import { buildCourseDescription } from '../../../utils/seo';
import Layout from '../../../layouts/Layout.astro';
import CourseView from '../../../components/gy11course.astro';
import { getLatestSubjectReportHref } from '../../../utils/changelog';
import GY11LegacyBanner from '../../../components/GY11LegacyBanner.astro';
import SourceNote from '../../../components/SourceNote.astro';

interface Course {
  code: string;
  name: string;
  points?: string;
  description?: string;
  centralContent?: {
    text: string;
  };
  knowledgeRequirements?: { text: string; gradeStep?: string }[];
}

interface StaticPath {
  params: {
    subjectCode: string;
    courseCode: string;
  };
  props: {
    subject: CollectionEntry<'gy11-subjects'>;
    course: Course;
    changeReportHref: string | null;
  };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  const subjects = await getCollection('gy11-subjects');
  const paths: StaticPath[] = [];

  subjects.forEach((subject) => {
    subject.data.courses?.forEach((course) => {
      paths.push({
        params: {
          subjectCode: subject.data.code.toLowerCase(),
          courseCode: course.code.toLowerCase(),
        },
        // /andringar/innehall visar bara GY25, så GY11 länkar till rapporten där ämnet finns.
        props: { subject, course, changeReportHref: getLatestSubjectReportHref('gy11', subject.data.code) },
      });
    });
  });

  return paths;
}

const { subject, course }: StaticPath['props'] = Astro.props;
// Utskriftsraden (VIK-169) identifierar sidan; källa och datum skrivs ut i källrutan (VIK-164).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title={`${course.name} (${course.code}) – GY11`}
  description={buildCourseDescription(
    `${course.name} (${course.code})${course.points ? `, ${course.points} poäng` : ''}, GY11`,
    course.centralContent?.text,
  )}
>
  <div class="max-w-4xl mx-auto px-4 mt-8 mb-8">
    <div class="mb-8 flex justify-between items-center print:hidden">
      <a href="/gy11/courses" class="text-blue-600 hover:text-blue-800 flex items-center gap-1 text-sm font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Tillbaka till GY11-kurser
      </a>

      <a href={`/gy11/${subject.data.code.toLowerCase()}`} class="text-blue-600 hover:text-blue-800 flex items-center gap-1 text-sm font-medium">
        Till ämnet {subject.data.name}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <p class="hidden print:block text-xs mb-4">
      {subject.data.name} ({subject.data.code}), {course.name} ({course.code}), GY11 · {pageUrl}
    </p>

    <div class="mb-6">
      <GY11LegacyBanner compact />
    </div>

    <CourseView course={course} subject={subject} />

    <SourceNote
      version="gy11"
      subjectName={subject.data.name}
      courseName={course.name}
      skolfsGrund={subject.data.skolfsGrund}
      skolfsAndring={subject.data.skolfsAndring}
      modifiedDate={subject.data.modifiedDate}
    />

    <section class="mt-10 border-t border-gray-200 pt-4 text-sm text-gray-600">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p>Ändringar i Skolverkets data listas i ändringsloggen.</p>
        </div>
        {Astro.props.changeReportHref && <a href={Astro.props.changeReportHref} class="font-medium text-blue-700 hover:text-blue-800">Se ändringar</a>}
      </div>
    </section>
  </div>
</Layout>
