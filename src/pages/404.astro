---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/gy25/', label: 'Ämnen och nivåer i GY25' },
  { href: '/gy11/', label: 'Ämnen och kurser i GY11' },
  { href: '/compare/', label: 'Jämför GY11 med GY25' },
  { href: '/andringar/', label: 'Ändringar' },
];
---

<Layout
  title="Sidan hittades inte (404)"
  description="Sidan du letade efter finns inte på GY25.se. Gå vidare till ämnen och nivåer i GY25, kurser i GY11 eller jämförelsen mellan dem."
>
  <div class="bg-white">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
        Sidan finns inte
      </h1>
      <p class="text-lg text-gray-600 mb-8">
        Länken du följde kan vara gammal eller felaktig. Prova någon av sidorna nedan.
      </p>

      <ul class="grid gap-3 sm:grid-cols-2 text-left mb-8">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md border border-gray-200 px-4 py-3 font-medium text-gray-900 hover:border-blue-300 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              {link.label} →
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/"
        class="inline-flex items-center px-4 py-2 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
      >
        Gå till startsidan
      </a>
    </div>
  </div>
</Layout>
