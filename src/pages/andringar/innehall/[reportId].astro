---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import {
    getChangeReportId,
    getImpactLabel,
    loadArchivedChangeReports,
    summarizeSubjectChange,
    toSvDate,
    type ArchivedChangeReport,
} from "../../../utils/changelog";

export const getStaticPaths = (() =>
    loadArchivedChangeReports().map((archive) => ({
        params: { reportId: getChangeReportId(archive.entry) },
        props: { archive },
    }))) satisfies GetStaticPaths;

interface Props {
    archive: ArchivedChangeReport;
}

const { archive } = Astro.props;
const { entry, report } = archive;
const range = `${toSvDate(entry.fromUpdatedAt)} → ${toSvDate(entry.toUpdatedAt)}`;
const versions = ["gy25", "gy11"] as const;
const detailLabels = {
    purpose: "Syfte",
    centralContent: "Centralt innehåll",
    gradeCriteria: "Betygskriterier och kunskapskrav",
    courses: "Ändringar per nivå eller kurs",
} as const;
---

<Layout title={`Ändringsrapport ${toSvDate(entry.toUpdatedAt)} - GY25.se`}>
    <main class="max-w-5xl mx-auto px-4 py-14">
        <a href="/andringar/innehall/" class="text-sm font-medium text-blue-700 hover:text-blue-800">
            ← Alla innehållsuppdateringar
        </a>
        <h1 class="mt-5 text-3xl font-bold text-gray-900">Ändringsrapport</h1>
        <p class="mt-3 text-lg text-gray-700">{range}</p>
        <p class="mt-2 text-sm text-gray-600">
            Här finns de ändringar som registrerades vid denna uppdatering.
            Ämneslänkarna leder till de nuvarande ämnesplanerna.
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                <p class="text-sm text-emerald-900">Hämtad av gy25.se</p>
                <p class="mt-1 font-semibold text-emerald-950">{toSvDate(entry.recordedAt)}</p>
            </div>
            <div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
                <p class="text-sm text-blue-900">Skolverkets API-version</p>
                <p class="mt-1 font-semibold text-blue-950">{entry.apiMetadata.apiVersion}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm text-slate-700">API-version publicerad</p>
                <p class="mt-1 font-semibold text-slate-900">{toSvDate(entry.apiMetadata.apiReleased)}</p>
            </div>
        </div>

        <div class="mt-8">
            <label for="archive-search" class="block text-sm font-medium text-gray-700 mb-2">
                Sök ämne eller ämneskod i denna uppdatering
            </label>
            <input id="archive-search" type="search" placeholder="Exempel: matematik, MATE, svenska..."
                class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none" />
            <p id="archive-no-results" hidden class="mt-4 text-gray-600" role="status">Inga ämnen matchar din sökning.</p>
        </div>

        {versions.map((version) => {
            const stats = entry.versions[version];
            const added = new Set(stats.addedCodes);
            const removed = new Set(stats.removedCodes);
            const subjects = [...report[version].entries].sort((a, b) =>
                (a.name ?? a.code).localeCompare(b.name ?? b.code, "sv-SE"));
            return (
                <details open={version === "gy25"} data-report-version={version} class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-6">
                    <summary class="cursor-pointer text-xl font-semibold text-gray-900">
                        {version.toUpperCase()} · {subjects.length} ämnen
                    </summary>
                    <p class="mt-3 text-sm text-gray-600">
                        {stats.changedCodes.length} ändrade, {stats.addedCodes.length} nya och {stats.removedCodes.length} borttagna ämnen.
                    </p>
                    <div class="mt-5 space-y-3">
                        {subjects.length === 0 && <p class="text-gray-600">Inga ämnesändringar i denna uppdatering.</p>}
                        {subjects.map((subject) => {
                            const groups = Object.entries(subject.details ?? {})
                                .filter(([, lines]) => lines.length > 0);
                            return (
                                <article data-archive-subject data-search={`${subject.name ?? ""} ${subject.code}`.toLowerCase()}
                                    class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <h2 class="text-lg font-semibold text-gray-900">
                                                {removed.has(subject.code) ? subject.name ?? subject.code : (
                                                    <a href={`/${version}/${subject.code.toLowerCase()}/`} class="hover:text-blue-700">
                                                        {subject.name ?? subject.code}
                                                    </a>
                                                )}
                                            </h2>
                                            <p class="mt-1 text-sm text-gray-500">{subject.code}</p>
                                        </div>
                                        <span class="rounded-md bg-slate-100 px-3 py-1 text-xs text-slate-700">
                                            {added.has(subject.code) ? "Nytt ämne" : removed.has(subject.code) ? "Borttaget ämne" : getImpactLabel(subject.level)}
                                        </span>
                                    </div>
                                    {subject.modifiedDate && <p class="mt-2 text-xs text-gray-500">Ändrad hos Skolverket: {toSvDate(subject.modifiedDate)}</p>}
                                    {subject.versionInfo && <p class="mt-1 text-xs text-gray-500">Skolverkets notering: {subject.versionInfo}</p>}
                                    <ul class="mt-3 text-sm text-gray-700 space-y-1">
                                        {summarizeSubjectChange(subject).map((line) => <li>{line}</li>)}
                                    </ul>
                                    {groups.length > 0 && (
                                        <details class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
                                            <summary class="cursor-pointer text-sm font-semibold text-slate-900">Visa vad som ändrats</summary>
                                            <div class="mt-3 space-y-4 text-sm text-slate-800">
                                                {groups.map(([key, lines]) => (
                                                    <section>
                                                        <h3 class="font-semibold">{detailLabels[key as keyof typeof detailLabels]}</h3>
                                                        <ul class="mt-1 list-disc pl-5 space-y-1">
                                                            {lines.map((line) => <li>{line}</li>)}
                                                        </ul>
                                                    </section>
                                                ))}
                                            </div>
                                        </details>
                                    )}
                                </article>
                            );
                        })}
                    </div>
                </details>
            );
        })}
    </main>
</Layout>

<script>
    const input = document.querySelector<HTMLInputElement>("#archive-search");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-archive-subject]"));
    const empty = document.querySelector<HTMLElement>("#archive-no-results");
    input?.addEventListener("input", () => {
        const term = input.value.trim().toLowerCase();
        cards.forEach((card) => {
            card.hidden = !card.dataset.search?.includes(term);
        });
        if (empty) empty.hidden = cards.some((card) => !card.hidden);
        document.querySelectorAll<HTMLDetailsElement>("[data-report-version]").forEach((section) => {
            section.open = term
                ? Array.from(section.querySelectorAll<HTMLElement>("[data-archive-subject]")).some((card) => !card.hidden)
                : section.dataset.reportVersion === "gy25";
        });
    });
</script>
