---
import { safeHtml } from '../utils/sanitize-html';
import type { CollectionEntry } from 'astro:content';
import CopyLinkButton from './CopyLinkButton.astro';
import { buildGradeMap, type GradeStep } from '../utils/grade-criteria';

interface Props {
  requirements: {
    text: string;
    gradeStep?: string;
  }[];
  title?: string;
  /** Ger sektionen och betygsstegen id (#betyg-e osv.). Bara en per sida. */
  anchorId?: string;
}


const { 
  requirements,
  title = "Betygskriterier",
  anchorId
} = Astro.props;

const gradeAnchor = (gradeStep?: string) =>
  anchorId && gradeStep && ['E', 'C', 'A'].includes(gradeStep) ? `betyg-${gradeStep.toLowerCase()}` : undefined;

const { gradeMap, maxCriteria } = buildGradeMap(requirements);

// Unika id:n per instans (aria-controls)
const uid = `gradereq-${Math.random().toString(36).slice(2, 8)}`;
const contentId = `${uid}-content`;
const gradeSteps: GradeStep[] = ['E', 'C', 'A'];

---

<section id={anchorId} data-anchor-section={anchorId ? '' : undefined} class="bg-white rounded-lg shadow-sm mb-6 relative z-10 scroll-mt-4" data-gradereq>
  <div class="p-6 flex flex-wrap justify-between items-center gap-x-4 gap-y-3 border-b border-gray-200 bg-white relative z-20">
    <h2 class="text-2xl font-bold text-gray-900">
      <button
        type="button"
        class="toggle-button flex items-center gap-2 text-left rounded-md"
        aria-expanded="true"
        aria-controls={contentId}
      >
        <span>{title}</span>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </h2>
    <div class="flex flex-wrap items-center gap-3">
      {anchorId && <CopyLinkButton anchor={anchorId} label={title} />}
      <div class="flex gap-2" role="group" aria-label="Visa betygskriterier som">
        <button
          type="button"
          class="view-toggle px-3 py-1.5 rounded-lg text-sm font-medium transition-colors"
          data-view="list"
          data-active="true"
          aria-pressed="true"
        >
          Lista
        </button>
        <button
          type="button"
          class="view-toggle px-3 py-1.5 rounded-lg text-sm font-medium transition-colors"
          data-view="table"
          data-active="false"
          aria-pressed="false"
        >
          Tabell
        </button>
      </div>
    </div>
  </div>

  <div id={contentId} class="section-content relative z-10 bg-white" data-section="grade-requirements">
    <!-- List View -->
    <div 
      class="view-content p-6" 
      data-view="list"
      style="display: block;"
    >
      <div class="prose space-y-8">
        {requirements.map((req) => {
          const gradeId = gradeAnchor(req.gradeStep);
          return gradeId ? (
            <div id={gradeId} class="relative scroll-mt-4" data-grade-step>
              <CopyLinkButton anchor={gradeId} label={`betyget ${req.gradeStep}`} class="absolute right-0 top-0" />
              <div set:html={safeHtml(req.text)} />
            </div>
          ) : (
            <div data-grade-step set:html={safeHtml(req.text)} />
          );
        })}
      </div>
    </div>

    <!-- Table View: tabell från md, staplad per kriterium under md -->
    <div 
      class="view-content p-6" 
      data-view="table"
      style="display: none;"
    >
      <div class="md:overflow-x-auto">
        <table class="block md:table w-full md:min-w-full md:divide-y md:divide-gray-200">
          <caption class="sr-only">{title}: kriterier för betygen E, C och A</caption>
          <thead class="hidden md:table-header-group">
            <tr class="bg-gray-50">
              {gradeSteps.map((gradeStep) => (
                <th scope="col" class="px-6 py-3 text-left text-sm font-medium text-gray-900">Betyget {gradeStep}</th>
              ))}
            </tr>
          </thead>
          <tbody class="block md:table-row-group bg-white divide-y divide-gray-200">
            {Array.from({ length: maxCriteria }, (_, index) => (
              <tr class="block md:table-row py-2 md:py-0">
                {gradeSteps.map((gradeStep) => (
                  <td class="block md:table-cell py-2 md:px-6 md:py-4 align-top">
                    <p class="md:hidden text-sm font-semibold text-gray-900 mb-1">Betyget {gradeStep}</p>
                    <div class="prose max-w-none" set:html={safeHtml(gradeMap[gradeStep].paragraphs[index] || '—')} />
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .view-toggle[data-active="true"] {
    background-color: rgb(37 99 235);
    color: white;
  }
  .view-toggle[data-active="false"] {
    background-color: rgb(243 244 246);
    color: rgb(75 85 99);
  }
  .view-toggle[data-active="false"]:hover {
    background-color: rgb(229 231 235);
  }
  
  .toggle-button svg {
    @apply text-gray-600 transition-transform;
  }
  
  .toggle-button[aria-expanded="true"] svg {
    @apply rotate-180;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[data-gradereq]').forEach((root) => {
      // View toggle functionality
      const viewToggles = root.querySelectorAll<HTMLButtonElement>('.view-toggle');
      const viewContents = root.querySelectorAll<HTMLElement>('.view-content');

      const applyView = (view: string | null) => {
        viewToggles.forEach((t) => {
          const active = t.getAttribute('data-view') === view;
          t.setAttribute('data-active', String(active));
          t.setAttribute('aria-pressed', String(active));
        });

        viewContents.forEach((content) => {
          content.style.display = content.getAttribute('data-view') === view ? '' : 'none';
        });
      };

      // Vyn sparas i ?vy=tabell (listvyn är standard och syns inte i URL:en)
      if (new URLSearchParams(window.location.search).get('vy') === 'tabell') {
        applyView('table');
      }

      viewToggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const view = toggle.getAttribute('data-view');
          applyView(view);

          const url = new URL(window.location.href);
          if (view === 'table') url.searchParams.set('vy', 'tabell');
          else url.searchParams.delete('vy');
          history.replaceState(history.state, '', url);
        });
      });

      // Fäll ihop/ut: hidden tar bort innehållet ur tabbordningen
      const toggleButton = root.querySelector<HTMLButtonElement>('.toggle-button');
      toggleButton?.addEventListener('click', () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        toggleButton.setAttribute('aria-expanded', String(!isExpanded));
        const section = document.getElementById(toggleButton.getAttribute('aria-controls') ?? '');
        if (section) section.hidden = isExpanded;
      });
    });
  });
</script>
