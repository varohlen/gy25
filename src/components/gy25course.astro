---
import { safeHtml } from '../utils/sanitize-html';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import GradeRequirements from './gradereq.astro';
import CopyLinkButton from './CopyLinkButton.astro';

interface Props {
  course: {
    name: string;
    code: string;
    points?: string;
    description?: string;
    centralCntHeading?: string;
    centralContent?: {
      text: string;
    };
    purpose?: string;
    knowledgeRequirements?: KnowledgeRequirement[];
  };
  subject: CollectionEntry<'gy25-subjects'>;
}

interface KnowledgeRequirement {
  text: string;
  gradeStep: string;
}

interface SubjectData {
  name: string;
  code: string;
  knowledgeRequirements: KnowledgeRequirement[];
  courses: {
    name: string;
    code: string;
    points: string;
  }[];
}

const { course, subject } = Astro.props;
const relatedCourses = (subject.data as SubjectData).courses?.filter(c => c.code !== course.code) || [];

// Process knowledge requirements to add grade levels
const processedRequirements = (subject.data as SubjectData).knowledgeRequirements?.map(req => {
  let gradeStep: 'E' | 'C' | 'A' | undefined;
  const text = req.text;
  
  if (text.includes('För betyget E') || text.includes('Betyget E')) gradeStep = 'E';
  else if (text.includes('För betyget C') || text.includes('Betyget C')) gradeStep = 'C';
  else if (text.includes('För betyget A') || text.includes('Betyget A')) gradeStep = 'A';
  
  return { text, gradeStep };
}) || [];

// Many levels have an empty description ("<p></p>"); only show it when it has text
const hasDescription = (course.description ?? '').replace(/<[^>]*>|&nbsp;|\s/g, '') !== '';
const subjectHref = `/gy25/${(subject.data as SubjectData).code.toLowerCase()}/`;

---

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Section 1: Course Header -->
  <div class="bg-white rounded-lg shadow-sm p-6">
    <div class="flex items-baseline justify-between">
      <h1 class="text-3xl font-bold text-gray-900 font-heading">
        {(subject.data as SubjectData).name} - {course.name}
      </h1>
      {course.points && (
        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
          {course.points} poäng
        </span>
      )}
    </div>
    {hasDescription && (
      <div class="prose max-w-none mt-4" set:html={course.description} />
    )}
  </div>

  <!-- Section 2: Central Content -->
  <div id="centralt-innehall" data-anchor-section class="scroll-mt-4 bg-white rounded-lg shadow-sm">
    <div class="flex items-center gap-2 pr-4">
      <h2 class="flex-1 min-w-0 text-2xl font-bold text-gray-900">
        <button 
          type="button"
          class="section-toggle w-full p-6 pr-2 flex justify-between items-center gap-4 text-left rounded-lg"
          aria-expanded="true"
          aria-controls="central-content-content"
        >
          <span>Centralt innehåll</span>
          <svg aria-hidden="true" class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </h2>
      <CopyLinkButton anchor="centralt-innehall" label="Centralt innehåll" class="flex-shrink-0" />
    </div>
    <div id="central-content-content" class="section-content p-6 pt-0" data-section="central-content">
      <div class="prose [&_ul]:list-disc [&_ul]:pl-8 [&_ul]:mb-6 [&_li]:mb-3 [&_li]:pl-2" set:html={safeHtml(course.centralContent?.text)} />
    </div>
  </div>

  <!-- Section 3: Knowledge Requirements -->
  {(subject.data as SubjectData).knowledgeRequirements && (
    <p class="text-gray-700 px-1">
      Betygskriterierna gäller för ämnet <a href={subjectHref} class="text-blue-700 underline hover:text-blue-900">{(subject.data as SubjectData).name}</a> som helhet (ämnesbetyg) och omfattar de nivåer eleven läst.
    </p>
  )}
  {(subject.data as SubjectData).knowledgeRequirements && (
    <GradeRequirements
      requirements={processedRequirements}
      title="Betygskriterier"
      defaultView="list"
      anchorId="betygskriterier"
    />
  )}

  <!-- Section 4: Related Courses -->
  {(subject.data as SubjectData).courses && (
    <div id="nivaer" data-anchor-section class="scroll-mt-4 bg-white rounded-lg shadow-sm">
      <div class="flex items-center gap-2 pr-4">
        <h2 class="flex-1 min-w-0 text-2xl font-bold text-gray-900">
          <button 
            type="button"
            class="section-toggle w-full p-6 pr-2 flex justify-between items-center gap-4 text-left rounded-lg"
            aria-expanded="true"
            aria-controls="related-courses-content"
          >
            <span>Fler nivåer i ämnet</span>
            <svg aria-hidden="true" class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </h2>
        <CopyLinkButton anchor="nivaer" label="Fler nivåer i ämnet" class="flex-shrink-0" />
      </div>
      <div id="related-courses-content" class="section-content p-6 pt-0" data-section="related-courses">
        <div class="space-y-6">
          {(subject.data as SubjectData).courses.map(relatedCourse => (
            <div class="flex items-baseline gap-4">
              {relatedCourse.code === course.code ? (
                <h3 class="text-lg font-medium text-gray-600" aria-current="page">
                  {relatedCourse.name}
                </h3>
              ) : (
                <a 
                  href={`/gy25/${(subject.data as SubjectData).code.toLowerCase()}/${relatedCourse.code.toLowerCase()}`}
                  class="group"
                >
                  <h3 class="text-lg font-medium text-gray-900 group-hover:text-blue-600">
                    {relatedCourse.name}
                  </h3>
                </a>
              )}
              <span class="text-sm font-mono text-gray-500">{relatedCourse.code}</span>
              {relatedCourse.points && (
                <span class="text-sm text-gray-500">
                  {relatedCourse.points} poäng
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .section-toggle svg {
    transition: transform 150ms;
  }
  .section-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLButtonElement>('.section-toggle[aria-controls]').forEach((button) => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        // hidden tar bort innehållet ur tabbordningen
        const content = document.getElementById(button.getAttribute('aria-controls') ?? '');
        if (content) content.hidden = isExpanded;
      });
    });
  });
</script>
