---
import { loadFetchReport, toSvDate } from '../utils/changelog';

interface Props {
  version: 'gy25' | 'gy11';
  subjectName: string;
  courseName?: string;
  skolfsGrund?: string;
  skolfsAndring?: string;
  modifiedDate?: string;
}

const { version, subjectName, courseName, skolfsGrund, skolfsAndring, modifiedDate } = Astro.props;

// SKOLFS-numren visas som text. PDF-länkarna på skolfs.skolverket.se kräver
// dokumenttyp (grund- eller ändringsförfattning), och Skolverkets data anger
// ibland fel typ i skolfsGrund/skolfsAndring, så en djuplänk blir inte stabil.
const skolfsSearchUrl = 'https://skolfs.skolverket.se/';

// Skolverket saknar en stabil djuplänk till en ämnesplan utifrån ämneskoden,
// så vi länkar till Skolverkets översiktssida för ämnen i respektive läroplan.
const skolverketSearchUrl =
  version === 'gy25'
    ? 'https://www.skolverket.se/undervisning/gymnasieskolan/program-och-amnen-i-gymnasieskolan/hitta-program-och-amnen-i-gymnasieskolan-gy25'
    : 'https://www.skolverket.se/undervisning/gymnasieskolan/program-och-amnen-i-gymnasieskolan/hitta-program-amnen-och-kurser-i-gymnasieskolan-gy11';

const fetchedAt = loadFetchReport()?.generatedAt;
const planName = courseName ? `${subjectName}, ${courseName}` : subjectName;
---

<aside class="mt-10 rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-700" aria-labelledby="source-note-heading">
  <h2 id="source-note-heading" class="text-base font-semibold text-gray-900">
    Källa: Skolverket, ämnesplan för {planName}
  </h2>
  <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[max-content_1fr]">
    {skolfsGrund && (
      <>
        <dt class="text-gray-500">Föreskrift</dt>
        <dd>SKOLFS {skolfsGrund}</dd>
      </>
    )}
    {skolfsAndring && (
      <>
        <dt class="text-gray-500">Ändring</dt>
        <dd>SKOLFS {skolfsAndring}</dd>
      </>
    )}
    {modifiedDate && (
      <>
        <dt class="text-gray-500">Ändrad hos Skolverket</dt>
        <dd><time datetime={modifiedDate}>{toSvDate(modifiedDate)}</time></dd>
      </>
    )}
    {fetchedAt && (
      <>
        <dt class="text-gray-500">Hämtad av gy25.se</dt>
        <dd><time datetime={fetchedAt}>{toSvDate(fetchedAt)}</time></dd>
      </>
    )}
  </dl>
  <p class="mt-3 text-xs text-gray-500">
    Texten är hämtad från Skolverkets öppna API. Den gällande ämnesplanen finns hos
    <a href={skolverketSearchUrl} class="underline hover:text-gray-700" rel="noopener noreferrer">Skolverket ({version.toUpperCase()})</a>.
    Föreskrifterna kan sökas fram i
    <a href={skolfsSearchUrl} class="underline hover:text-gray-700" rel="noopener noreferrer">Skolverkets författningssamling</a>.
  </p>
</aside>
